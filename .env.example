# Copy this file to .env and fill it in. Never commit .env.

# Discord Developer Portal -> your app -> Bot -> Reset Token (shown once)
DISCORD_TOKEN=

# Discord Developer Portal -> your app -> General Information -> Application ID
CLIENT_ID=

# Optional: your test server's ID. Commands then appear instantly instead of after up to an hour.
GUILD_ID=

# Free key from https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# Optional: where wishlist data is stored (default data/steamvaluechecker.db). Back this file up.
DATABASE_PATH=

# Optional: minutes between wishlist price checks (default 60, minimum 30)
CHECK_INTERVAL_MINUTES=

# Optional web dashboard. It starts only when BOTH of these are set.
# Discord Developer Portal -> OAuth2 -> Client Secret, and add  <DASHBOARD_URL>/auth/callback  under OAuth2 -> Redirects
DISCORD_CLIENT_SECRET=
# The public address people open, no trailing slash. Local test: http://localhost:3000
DASHBOARD_URL=
# Port and bind address (default 3000 on 127.0.0.1; put a reverse proxy with HTTPS in front for a public site)
DASHBOARD_PORT=
DASHBOARD_HOST=

# Optional: your own Discord user ID. You get a DM if price checks or backups keep failing, and the dashboard shows you an Admin page.
OWNER_DISCORD_ID=
# Optional: a daily copy of the database is kept here (default data/backups), newest 7 by default.
# Backups hold the same personal data as the database, so protect them the same way.
BACKUP_DIR=
BACKUP_KEEP=
# Set to 1 only if the dashboard sits behind a reverse proxy you control (it then trusts X-Forwarded-For for rate limiting)
DASHBOARD_TRUST_PROXY=

# Required for /giveaway: a long random secret (16+ characters) used to encrypt prize keys at rest.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep it safe and do not change it: keys saved under a lost or changed secret cannot be read again.
# Leave empty to turn giveaways off.
KEY_ENCRYPTION_SECRET=

# Optional: the creator credit on /about and the dashboard (defaults shown)
CREATOR_NAME=Jacob Lucado
CREATOR_X_URL=https://x.com/twit_user69

# Set to 1 to register commands globally even if GUILD_ID is set. Needed so people can add the app to their own account.
# (Global commands can take up to an hour to show up. The test server's own copies are cleared so nothing appears twice.)
GLOBAL_COMMANDS=

# Optional AI companion. The bot's own key (ANTHROPIC_API_KEY also works as the name when the service is Anthropic).
# Without a key the bot only answers the common questions itself, except in servers that bring their own key (those need KEY_ENCRYPTION_SECRET above).
AI_API_KEY=
# Which service that key is for: anthropic (default), openai, gemini, openrouter, groq, mistral, xai or deepseek. The admin AI page can change it live.
AI_PROVIDER=
# The model for answers (default claude-haiku-5-5 for Anthropic; for any other service, type that service's model name) and the default answers per server per day (default 300)
AI_MODEL=
AI_DAILY_CAP=

# Optional: your own (support) server. Defaults to the one server the bot was first in. The AI is never limited there.
MAIN_GUILD_ID=
# Optional: a Discord invite for the Support server button. Leave empty and the bot makes a permanent one itself.
SUPPORT_SERVER_URL=https://discord.gg/uCqSXgwSCQ

# Time zone used when someone has not picked one (quiet hours, digests, event times). Default America/New_York.
DEFAULT_TZ=America/New_York

# Twitch chat entry (!enter). Reading chat needs nothing. To let the bot answer in chat, give it its own Twitch account:
# TWITCH_BOT_LOGIN is that account's name, TWITCH_BOT_TOKEN an OAuth token for it with the chat:read and chat:edit scopes.
# TWITCH_BOT_LOGIN=
# TWITCH_BOT_TOKEN=
# TWITCH_CHAT=off   # turns the chat listener off completely

# Automatic go-live posts. YouTube needs nothing. Twitch and Kick each need a free app from their developer site:
# TWITCH_CLIENT_ID / TWITCH_CLIENT_SECRET   (dev.twitch.tv/console -> Register Your Application -> Client Credentials)
# KICK_CLIENT_ID / KICK_CLIENT_SECRET       (kick.com settings -> Developer tab -> Create app)
# TWITCH_CLIENT_ID=
# TWITCH_CLIENT_SECRET=
# KICK_CLIENT_ID=
# KICK_CLIENT_SECRET=

# Optional: a channel ID where new release notes get posted when the bot updates
RELEASE_CHANNEL_ID=

# Optional: supporter passes through Square. Leave these empty and the Chip in page only shows the PayPal tip.
# The webhook address to give Square is https://YOUR-SITE/api/square/webhook, with the payment.updated event turned on.
SQUARE_ACCESS_TOKEN=
SQUARE_LOCATION_ID=
SQUARE_WEBHOOK_SIGNATURE_KEY=
# Set to sandbox while testing with Square's sandbox keys
SQUARE_ENV=
