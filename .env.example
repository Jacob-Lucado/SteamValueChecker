# Copy this file to .env and fill it in. Never commit .env.

# Discord Developer Portal -> your app -> Bot -> Reset Token (shown once)
DISCORD_TOKEN=

# Discord Developer Portal -> your app -> General Information -> Application ID
CLIENT_ID=

# Optional: your test server's ID. Commands then appear instantly instead of after up to an hour.
GUILD_ID=

# Free key from https://isthereanydeal.com/apps/my/
ITAD_API_KEY=

# Optional: where wishlist data is stored (default data/steamvaluechecker.db). Back this file up.
DATABASE_PATH=

# Optional: minutes between wishlist price checks (default 60, minimum 30)
CHECK_INTERVAL_MINUTES=

# Optional web dashboard. It starts only when BOTH of these are set.
# Discord Developer Portal -> OAuth2 -> Client Secret, and add  <DASHBOARD_URL>/auth/callback  under OAuth2 -> Redirects
DISCORD_CLIENT_SECRET=
# The public address people open, no trailing slash. Local test: http://localhost:3000
DASHBOARD_URL=
# Port and bind address (default 3000 on 127.0.0.1; put a reverse proxy with HTTPS in front for a public site)
DASHBOARD_PORT=
DASHBOARD_HOST=
