+import { IMessageDataWrapper, IMessageParser } from '@volt/api';
+
+export class RoomStreamMessageParser implements IMessageParser
+{
+    private _roomId: number;
+    private _kind: string;
+    private _url: string;
+    private _setBy: string;
+
+    flush(): boolean
+    {
+        this._roomId = 0;
+        this._kind = '';
+        this._url = '';
+        this._setBy = '';
+
+        return true;
+    }
+
+    parse(wrapper: IMessageDataWrapper): boolean
+    {
+        this._roomId = wrapper.readInt();
+        this._kind = wrapper.readString();
+        this._url = wrapper.readString();
+        this._setBy = wrapper.readString();
+
+        return true;
+    }
+
+    public get roomId(): number
+    {
+        return this._roomId;
+    }
+
+    public get kind(): string
+    {
+        return this._kind;
+    }
+
+    public get url(): string
+    {
+        return this._url;
+    }
+
+    public get setBy(): string
+    {
+        return this._setBy;
+    }
+}
