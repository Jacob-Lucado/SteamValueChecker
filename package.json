{
  "name": "steam-value-checker",
  "version": "1.0.0",
  "description": "Discord bot that prices a game library: MSRP, Steam price, cheapest price now, and what you saved. Works with FanaticalGrabber exports.",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "register": "node src/register.js",
    "legal-pdf": "node scripts/legal-pdf.mjs",
    "test": "node --test --test-force-exit"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@resvg/resvg-js": "^2.6.2",
    "@snazzah/davey": "^0.1.12",
    "discord.js": "^14.28.1",
    "dotenv": "^16.4.5",
    "opusscript": "^0.0.8",
    "playwright-core": "^1.63.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "license": "MIT",
  "optionalDependencies": {
    "@discordjs/opus": "^0.11.0"
  }
}
